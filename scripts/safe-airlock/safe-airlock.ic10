define INNER_PRESSURE 0.1
define OUTER_PRESSURE 0.1
define VACUUM_PRESSURE 0.1
define PRESSURE_TOLERANCE 1
define WAIT_LIMIT 600
alias innerDoor d0
alias outerDoor d1
alias innerVent d2
alias outerVent d3
alias sensor d4
alias light d5
bdns innerDoor configFault
bdns outerDoor configFault
bdns innerVent configFault
bdns outerVent configFault
bdns sensor configFault
s innerVent On 0
s outerVent On 0
s innerDoor Mode 1
s outerDoor Mode 1
move r4 3
move r5 2
move r6 0
move r7 1
move r2 INNER_PRESSURE
move r3 0
j cycle
configFault:
s db Setting -2
yield
j configFault
cycle:
s db Setting 2
brdns light 2
s light On 1
jal seal
s dr4 Mode 1
s dr4 PressureExternal VACUUM_PRESSURE
s dr4 On 1
jal waitVacuum
s dr4 On 0
ble r2 VACUUM_PRESSURE openDestination
s dr5 Mode 0
s dr5 PressureExternal r2
s dr5 On 1
sub r8 r2 PRESSURE_TOLERANCE
jal waitPressure
s dr5 On 0
openDestination:
s innerVent On 0
s outerVent On 0
s dr6 Open 1
move r0 0
waitOpen:
yield
l r1 dr6 Open
bnez r1 idle
add r0 r0 1
bge r0 WAIT_LIMIT fault
j waitOpen
idle:
brdns light 2
s light On 0
s db Setting r3
s dr6 Setting 1
s dr7 Setting 0
s innerDoor Lock 0
s outerDoor Lock 0
idleWait:
yield
l r8 dr7 Setting
l r1 dr7 Open
bne r8 r1 requested
j idleWait
requested:
move r8 r4
move r4 r5
move r5 r8
move r8 r6
move r6 r7
move r7 r8
seqz r3 r3
select r2 r3 OUTER_PRESSURE INNER_PRESSURE
j cycle
seal:
s innerDoor Lock 1
s outerDoor Lock 1
s innerDoor Open 0
s outerDoor Open 0
move r0 0
sealWait:
yield
l r1 innerDoor Open
l r8 outerDoor Open
or r1 r1 r8
beqz r1 ra
add r0 r0 1
bge r0 WAIT_LIMIT fault
j sealWait
waitVacuum:
move r0 0
vacuumWait:
yield
l r1 sensor Pressure
ble r1 VACUUM_PRESSURE ra
add r0 r0 1
bge r0 WAIT_LIMIT fault
j vacuumWait
waitPressure:
move r0 0
pressureWait:
yield
l r1 sensor Pressure
bge r1 r8 ra
add r0 r0 1
bge r0 WAIT_LIMIT fault
j pressureWait
fault:
s innerVent On 0
s outerVent On 0
s innerDoor Open 0
s outerDoor Open 0
s innerDoor Lock 1
s outerDoor Lock 1
s db Setting -1
faultWait:
yield
j faultWait
