alias commX d0
alias commZ d1
alias job d2
alias command d3
alias status d4
alias drone d5
define STORMTIME 600
define WEATHER 1997212478
define HANGAR_SMALL 1736080881
define HANGAR_MEDIUM -566348148
define HANGAR_LARGE -1351081801
define SWITCH 1220484876
define BUTTON 491845673
define LED -815193061
define RECALL_NAME HASH("AIMeE Recall")
define HANGAR_NAME HASH("AIMeE Hangar")
boot:
l r0 command Setting
beq r0 2 complete_wait
j recall
run:
jal doors_open
s command Setting 0
run_wait:
yield
jal displays
l r0 command Setting
beq r0 2 complete_wait
jal danger
bnez r0 recall
j run_wait
recall:
s command Setting 1
jal doors_open
recall_wait:
yield
jal displays
l r0 command Setting
beq r0 2 complete_wait
l r0 status Setting
bne r0 1 recall_wait
jal doors_close
recall_hold:
yield
jal displays
l r0 command Setting
beq r0 2 complete_parked
jal danger
bnez r0 recall_hold
j run
complete_wait:
s command Setting 2
jal doors_open
complete_return:
yield
jal displays
l r0 status Setting
bne r0 1 complete_return
complete_parked:
jal doors_close
complete_hold:
yield
jal displays
l r0 command Setting
beq r0 2 complete_hold
j boot
reset:
s command Setting 1
s job Setting 0
j recall
doors_open:
sbn HANGAR_SMALL HANGAR_NAME Open 1
sbn HANGAR_MEDIUM HANGAR_NAME Open 1
sbn HANGAR_LARGE HANGAR_NAME Open 1
j ra
doors_close:
sbn HANGAR_SMALL HANGAR_NAME Open 0
sbn HANGAR_MEDIUM HANGAR_NAME Open 0
sbn HANGAR_LARGE HANGAR_NAME Open 0
j ra
danger:
lbn r0 SWITCH RECALL_NAME Open Average
snan r1 r0
bnez r1 dangerous
bnez r0 dangerous
lb r0 WEATHER Mode Average
snan r1 r0
bnez r1 dangerous
beqz r0 safe
bne r0 1 dangerous
lb r0 WEATHER NextWeatherEventTime Minimum
blt r0 STORMTIME dangerous
safe:
move r0 0
j ra
dangerous:
move r0 1
j ra
displays:
lbn r0 BUTTON HASH("AIMeE Reset") Setting Maximum
bgtz r0 reset
sbn LED HASH("AIMeE X") Mode 0
sbn LED HASH("AIMeE Z") Mode 0
sbn LED HASH("AIMeE Mode") Mode 0
sbn LED HASH("AIMeE Charge") Mode 0
l r0 drone PositionX
sbn LED HASH("AIMeE X") Setting r0
l r0 drone PositionZ
sbn LED HASH("AIMeE Z") Setting r0
l r0 drone Mode
sbn LED HASH("AIMeE Mode") Setting r0
sbn LED HASH("AIMeE Mode") Color r0
ls r0 drone 0 ChargeRatio
mul r0 r0 100
sbn LED HASH("AIMeE Charge") Setting r0
l r0 commX Setting
sbn LED HASH("AIMeE Target X") Setting r0
l r0 commZ Setting
sbn LED HASH("AIMeE Target Z") Setting r0
l r0 job Setting
sbn LED HASH("AIMeE Job") Setting r0
l r0 command Setting
sbn LED HASH("AIMeE Command") Setting r0
l r0 status Setting
sbn LED HASH("AIMeE Status") Setting r0
lb r0 WEATHER NextWeatherEventTime Minimum
sbn LED HASH("AIMeE Storm ETA") Setting r0
j ra
