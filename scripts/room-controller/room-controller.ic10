define ROOM_NAME HASH("Room")
define LIGHTS_SWITCH_NAME HASH("Lights")
define OCCUPANCY_SENSOR 322782515
define SWITCH 1220484876
define LIGHT_LONG 797794350
define LIGHT_LONG_ANGLED 1847265835
define LIGHT_LONG_WIDE 555215790
define LIGHT_ROUND 1514476632
define LIGHT_ROUND_ANGLED 1592905386
define LIGHT_ROUND_SMALL 1436121888
define WALL_LIGHT -1860064656
define WALL_LIGHT_BATTERY -1306415132
main:
lbn r0 OCCUPANCY_SENSOR ROOM_NAME Activate Maximum
sgtz r0 r0
lbn r1 SWITCH LIGHTS_SWITCH_NAME PrefabHash Sum
seqz r2 r1
lbn r1 SWITCH LIGHTS_SWITCH_NAME Open Minimum
sgtz r1 r1
or r1 r1 r2
and r0 r0 r1
sbn LIGHT_LONG ROOM_NAME On r0
sbn LIGHT_LONG_ANGLED ROOM_NAME On r0
sbn LIGHT_LONG_WIDE ROOM_NAME On r0
sbn LIGHT_ROUND ROOM_NAME On r0
sbn LIGHT_ROUND_ANGLED ROOM_NAME On r0
sbn LIGHT_ROUND_SMALL ROOM_NAME On r0
sbn WALL_LIGHT ROOM_NAME On r0
sbn WALL_LIGHT_BATTERY ROOM_NAME On r0
yield
j main
