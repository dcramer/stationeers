define FILL_START_PRESSURE 65
define FILL_TARGET_PRESSURE 75
define HIGH_PRESSURE 100
define VENT_TARGET_PRESSURE 90
define MIN_CO2_RATIO 0.05
define CO2_FILL_PRESSURE 90
define CO2_PURGE_PRESSURE 75
define COOL_START_TEMP 305.15
define COOL_STOP_TEMP 303.15
define MIN_CO2_REFRESH_TEMP 288.15
define MAX_PIPE_PRESSURE 5000
alias sensor d0
alias growLight d1
alias vent d2
alias daylight d3
alias pressure r0
alias co2Ratio r1
alias temperature r2
alias work r3
alias cooling r4
alias refreshPhase r5
start:
move sp 0
move cooling 0
move refreshPhase 0
jal safeOff
bdns sensor fault
bdns growLight fault
bdns vent fault
bdns daylight fault
s vent Lock 1
main:
bdns sensor fault
bdns growLight fault
bdns vent fault
bdns daylight fault
l pressure sensor Pressure
bnan pressure fault
l work sensor Combustion
bnez work fault
s db Setting pressure
l work daylight Activate
s growLight On work
bgt pressure HIGH_PRESSURE ventHigh
blt pressure FILL_START_PRESSURE fillLow
l temperature sensor Temperature
bnan temperature fault
bge temperature COOL_START_TEMP coolingOn
ble temperature COOL_STOP_TEMP coolingOff
coolingReady:
beq refreshPhase 1 refreshPurge
beq refreshPhase 2 refreshFill
bnez cooling refreshAir
l co2Ratio sensor RatioCarbonDioxide
bnan co2Ratio fault
blt temperature MIN_CO2_REFRESH_TEMP ventOff
blt co2Ratio MIN_CO2_RATIO refreshAir
j ventOff
coolingOn:
move cooling 1
j coolingReady
coolingOff:
move cooling 0
j coolingReady
fillLow:
move work FILL_TARGET_PRESSURE
j pumpOut
ventHigh:
move work VENT_TARGET_PRESSURE
j pumpIn
refreshAir:
bge pressure CO2_FILL_PRESSURE startPurge
move refreshPhase 2
j refreshFill
startPurge:
move refreshPhase 1
refreshPurge:
ble pressure CO2_PURGE_PRESSURE purgeDone
move work CO2_PURGE_PRESSURE
j pumpIn
purgeDone:
move refreshPhase 2
refreshFill:
bge pressure CO2_FILL_PRESSURE refreshDone
move work CO2_FILL_PRESSURE
j pumpOut
refreshDone:
move refreshPhase 0
ventOff:
s vent On 0
wait:
yield
j main
pumpIn:
l temperature vent Mode
bnez temperature pumpInReady
s vent On 0
s vent Mode 1
pumpInReady:
s vent PressureExternal work
s vent PressureInternal MAX_PIPE_PRESSURE
s vent On 1
j wait
pumpOut:
l temperature vent Mode
beqz temperature pumpOutReady
s vent On 0
s vent Mode 0
pumpOutReady:
s vent PressureExternal work
s vent PressureInternal 0
s vent On 1
j wait
fault:
jal safeOff
s db Setting -1
yield
j start
safeOff:
bdns growLight noLightOff
s growLight On 0
noLightOff:
bdns vent safeOffDone
s vent On 0
safeOffDone:
j ra
